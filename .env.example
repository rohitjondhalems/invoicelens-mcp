# Copy to .env. With nothing set, InvoiceLens runs offline (hashing embedder + rule extractor).

# Azure OpenAI (used automatically when endpoint + key are set)
INVOICELENS_AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
INVOICELENS_AZURE_OPENAI_API_KEY=
INVOICELENS_AZURE_EMBEDDING_DEPLOYMENT=text-embedding-3-large
INVOICELENS_AZURE_CHAT_DEPLOYMENT=gpt-4o
# INVOICELENS_AZURE_OPENAI_API_VERSION=2024-10-21

# Or OpenAI directly
# INVOICELENS_OPENAI_API_KEY=

# Force a provider: auto | azure | openai | local
# INVOICELENS_EMBEDDING_PROVIDER=auto
# INVOICELENS_EXTRACTION_PROVIDER=auto

# Vendor research tools (optional; each tool explains itself if its key is missing)
# INVOICELENS_TAVILY_API_KEY=tvly-...      # web search: https://app.tavily.com
# INVOICELENS_FMP_API_KEY=                 # market data: https://site.financialmodelingprep.com
# INVOICELENS_MARKET_DATA_CACHE_S=600

# Storage and chunking
# INVOICELENS_DATA_DIR=./data
# INVOICELENS_CHUNK_MAX_TOKENS=512
# INVOICELENS_CHUNK_OVERLAP_TOKENS=64

# Networked deployments: require a bearer token and disable server-side paths
# INVOICELENS_API_TOKEN=
# INVOICELENS_ALLOW_LOCAL_PATHS=false

# For the example agent (agent/run.py)
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o
# INVOICELENS_MCP_URL=http://127.0.0.1:8765/mcp
